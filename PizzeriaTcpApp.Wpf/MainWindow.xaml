<Window x:Class="PizzeriaTcpApp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PizzeriaTcpApp.Wpf"
        xmlns:converters="clr-namespace:PizzeriaTcpApp.Wpf.Converters"
        mc:Ignorable="d"
        Title="Клиент Пиццерии (Микросервисы)" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:IngredientsConverter x:Key="IngredientsConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <TabControl>
            <!-- ВКЛАДКА 1: СДЕЛАТЬ ЗАКАЗ -->
            <TabItem Header="Сделать заказ">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <Label DockPanel.Dock="Top" Content="Выберите пиццу:" FontWeight="Bold"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Label Content="Кол-во:"/>
                            <TextBox x:Name="QuantityTextBox" Width="40" Text="1" VerticalContentAlignment="Center"/>
                            <Button x:Name="AddToOrderButton" Content="Добавить в заказ" Margin="10,0,0,0" Padding="5" Click="AddToOrderButton_Click"/>
                        </StackPanel>
                        <ListBox x:Name="MenuForOrderListBox" DisplayMemberPath="Name"/>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="Gainsboro"/>

                    <DockPanel Grid.Column="2" Margin="5,0,0,0">
                        <Label DockPanel.Dock="Top" Content="Ваш заказ:" FontWeight="Bold"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Имя клиента:" FontWeight="SemiBold"/>
                                <TextBox x:Name="CustomerNameTextBox" Grid.Column="1"/>
                            </Grid>
                            <TextBlock x:Name="TotalPriceTextBlock" Text="Итого: 0.00 руб." FontSize="16" FontWeight="Bold" Margin="0,10,0,10" HorizontalAlignment="Right"/>
                            <Button x:Name="PlaceOrderButton" Content="Оформить заказ" Padding="10,5" HorizontalAlignment="Stretch" Background="LightGreen" Click="PlaceOrderButton_Click"/>
                        </StackPanel>
                        <ListView x:Name="CartListView">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Название" Width="180" DisplayMemberBinding="{Binding PizzaName}"/>
                                    <GridViewColumn Header="Кол-во" Width="50" DisplayMemberBinding="{Binding Quantity}"/>
                                    <GridViewColumn Header="Цена" Width="80" DisplayMemberBinding="{Binding Price, StringFormat={}{0:F2}}"/>
                                    <GridViewColumn Header="Сумма" Width="80" DisplayMemberBinding="{Binding SubTotal, StringFormat={}{0:F2}}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА 2: МЕНЮ -->
            <TabItem Header="Меню">
                <Grid Margin="5">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                            <Button Content="Обновить меню" Margin="0,0,20,0" Click="RefreshMenuButton_Click"/>

                            <Label Content="Название:"/>
                            <TextBox x:Name="NewPizzaNameTextBox" Width="120"/>
                            <Label Content="Ингредиенты (через запятую):" Margin="10,0,0,0"/>
                            <TextBox x:Name="NewPizzaIngredientsTextBox" Width="200"/>
                            <Label Content="Цена:" Margin="10,0,0,0"/>
                            <TextBox x:Name="NewPizzaPriceTextBox" Width="60"/>
                            <Button Content="Добавить в меню" Margin="10,0,0,0" Click="AddPizzaButton_Click"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Margin="5,0,0,0">
                            <Button x:Name="EditPizzaButton" Content="Редактировать" Margin="5" Padding="5" Click="EditPizzaButton_Click"/>
                            <Button x:Name="DeletePizzaButton" Content="Удалить" Margin="5" Padding="5" Background="LightCoral" Click="DeletePizzaButton_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="MenuDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Ингредиенты" Binding="{Binding Ingredients, Converter={StaticResource IngredientsConverter}}" Width="3*"/>
                                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:F2} руб.}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
            <!-- НОВАЯ ВКЛАДКА УПРАВЛЕНИЯ ЗАКАЗАМИ -->
            <TabItem Header="Управление заказами">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <Button DockPanel.Dock="Top" Content="Обновить список заказов" Margin="5" Click="RefreshOrdersButton_Click"/>
                        <ListView x:Name="OrdersListView" SelectionChanged="OrdersListView_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="40"/>
                                    <GridViewColumn Header="Клиент" DisplayMemberBinding="{Binding CustomerName}" Width="100"/>
                                    <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding OrderDate, StringFormat='g'}" Width="120"/>
                                    <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding Status}" Width="80"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>

                    <DockPanel Grid.Column="1" Margin="10,0,0,0" x:Name="OrderDetailsPanel" IsEnabled="False">
                        <StackPanel DockPanel.Dock="Bottom" Margin="5">
                            <Button x:Name="SaveChangesToOrderButton" Content="Сохранить изменения в заказе" Margin="5" Padding="5" Background="LightGreen" Click="SaveChangesToOrderButton_Click"/>
                            <Button x:Name="DeleteOrderButton" Content="Удалить заказ" Margin="5" Padding="5" Background="LightCoral" Click="DeleteOrderButton_Click"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top">
                            <Label Content="Детали заказа" FontWeight="Bold"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Label Grid.Column="0" Grid.Row="0" Content="Имя клиента:"/>
                                <TextBox Grid.Column="1" Grid.Row="0" x:Name="OrderCustomerNameTextBox"/>

                                <Label Grid.Column="0" Grid.Row="1" Content="Дата заказа:"/>
                                <DatePicker Grid.Column="1" Grid.Row="1" x:Name="OrderDatePicker"/>

                                <Label Grid.Column="0" Grid.Row="2" Content="Статус:"/>
                                <ComboBox Grid.Column="1" Grid.Row="2" x:Name="OrderStatusComboBox"/>
                            </Grid>
                            <Label Content="Состав заказа:" Margin="0,10,0,0"/>
                            <ListView x:Name="OrderItemsListView" Height="200">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Название" DisplayMemberBinding="{Binding PizzaName}" Width="200"/>
                                        <GridViewColumn Header="Кол-во">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Quantity}" Width="40"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Цена" DisplayMemberBinding="{Binding PriceAtTimeOfOrder, StringFormat={}{0:F2}}" Width="80"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Border Margin="0,10,0,0" Padding="5" BorderBrush="Gainsboro" BorderThickness="1">
                                <StackPanel>
                                    <Label Content="Добавить/удалить позицию:"/>
                                    <ComboBox x:Name="PizzaToAddComboBox" DisplayMemberPath="Name" Margin="0,0,0,5"/>
                                    <WrapPanel HorizontalAlignment="Right">
                                        <Button Content="Добавить пиццу в заказ" Margin="5" Click="AddPizzaToExistingOrder_Click"/>
                                        <Button Content="Удалить выбранную позицию" Margin="5" Background="LightPink" Click="RemovePizzaFromExistingOrder_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>
            
            <!-- ВКЛАДКА 3: ОТЧЕТЫ -->
            <TabItem Header="Отчеты">
                <DockPanel Margin="5">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                        <Label Content="Выберите отчет:"/>
                        <ComboBox x:Name="ReportsComboBox" Width="250" SelectionChanged="ReportsComboBox_SelectionChanged"/>
                        <StackPanel x:Name="DateRangePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="10,0,0,0">
                            <Label Content="С:"/>
                            <DatePicker x:Name="FromDatePicker"/>
                            <Label Content="По:"/>
                            <DatePicker x:Name="ToDatePicker"/>
                        </StackPanel>
                        <Button Content="Сформировать" Margin="10,0,0,0" Click="GenerateReportButton_Click"/>
                    </StackPanel>
                    <TextBox x:Name="ReportResultsTextBox" Margin="5" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True" FontFamily="Consolas"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>